AUTOAPPLY_ACCOUNT_EMAIL=your_dashboard_email@example.com
AUTOAPPLY_ACCOUNT_PASSWORD=your_dashboard_password_here
# Optional: target a specific local dashboard user id instead of looking up by email.
# AUTOAPPLY_ACCOUNT_USER_ID=1
# Scheduler run mode:
#   watch          = trigger the dashboard's normal Run and Watch flow (LinkedIn search flow)
#   external_watch = trigger the dashboard's External Websites Watch flow (WeWorkRemotely, RemoteOK, etc.)
AUTOAPPLY_RUN_MODE=watch
AUTOAPPLY_BASE_URL=http://127.0.0.1:5000
AUTOAPPLY_POLL_SECONDS=60
AUTOAPPLY_RUN_ON_LOGIN=0
# Optional overrides:
# AUTOAPPLY_DB_PATH=d:\cv_portofolio\webapp\app.db
# AUTOAPPLY_PYTHON_EXE=d:\cv_portofolio\.venv\Scripts\python.exe
# AUTOAPPLY_WEBAPP_ENTRY=app.py
